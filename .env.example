APP_NAME=Aadil HR Hunter Command Center
APP_ENV=development
DATABASE_PATH=data/hunter.db
AADIL_HR_HUNTER_PROJECT=
AADIL_HR_HUNTER_RUNTIME=
AADIL_HR_HUNTER_LOGS=
AADIL_HR_HUNTER_PLATFORM=
SCHEDULER_BACKEND=
PYTHONUNBUFFERED=1

FASTAPI_HOST=127.0.0.1
FASTAPI_BASE_URL=
STREAMLIT_PORT=8501
FASTAPI_PORT=8000
STREAMLIT_HOST=127.0.0.1
N8N_HOST=127.0.0.1
N8N_PORT=5678
N8N_BASE_URL=
N8N_USER_FOLDER=
N8N_DATABASE_PATH=

OLLAMA_ENABLED=false
OLLAMA_REQUIRED=false
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_BASE_URL=
HR_AGENT_OLLAMA_MODEL=gemma3:4b
HR_AGENT_OLLAMA_TIMEOUT_SECONDS=600
HR_AGENT_PROCESS_TIMEOUT_SECONDS=240
DICE_BROWSER_EXECUTABLE=

N8N_TEST_WEBHOOK_URL=
N8N_PRODUCTION_WEBHOOK_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HUNTER_API_SECRET=

# Resume Studio / encrypted integration secrets. Runtime values only; never commit real values.
MUNSHI_VAULT_KEY=
OPENAI_API_KEY=
MUNSHI_RESUME_MODEL=gpt-5.6-terra

# Complete Application Loop V1. All higher-risk capabilities remain explicitly
# disabled by default. Enabling a source flag does not itself deploy or authorize
# a final employer submission.
MUNSHI_APPLICATION_ANSWER_BRAIN_ENABLED=false
MUNSHI_NATIVE_RESUME_V5_ENABLED=false
MUNSHI_APPLICATION_PLAN_V2_ENABLED=false
MUNSHI_APPLY_LIVE_HANDOFF_ENABLED=false
MUNSHI_APPLY_BACKGROUND_PREPARE_ENABLED=false
MUNSHI_FINAL_REVIEW_ENABLED=false
MUNSHI_FINAL_SUBMIT_ENABLED=false
MUNSHI_MAIL_CONFIRMATION_INTELLIGENCE_ENABLED=false
MUNSHI_APPLY_HANDOFF_HMAC_SECRET=

# Stage 6B container parity defaults (safe placeholders only; inject secrets at runtime).
FASTAPI_CONTAINER_BASE_URL=http://hunter:8000
CONTAINER_N8N_BASE_URL=http://n8n:5678
CONTAINER_OLLAMA_BASE_URL=http://ollama:11434
HUNTER_ENABLE_TELEGRAM=false
HUNTER_ENABLE_DISCOVERY_SCHEDULER=false
HUNTER_ENABLE_COORDINATOR=false
N8N_ENCRYPTION_KEY=
