# Netcup shadow example. Placeholders only; never put production values here.
COMPOSE_PROJECT_NAME=munshi-netcup-shadow
HUNTER_FASTAPI_PORT_MAPPING=127.0.0.1:8000:8000
HUNTER_STREAMLIT_PORT_MAPPING=127.0.0.1:8501:8501
N8N_PORT_MAPPING=127.0.0.1:5678:5678
HUNTER_API_SECRET=REPLACE_WITH_SYNTHETIC_SHADOW_SECRET
N8N_ENCRYPTION_KEY=REPLACE_WITH_SYNTHETIC_SHADOW_KEY

# Resume Studio / encrypted integration runtime placeholders.
# Use synthetic/non-production values in shadow or staging. Never commit live secrets.
MUNSHI_VAULT_KEY=
OPENAI_API_KEY=
MUNSHI_RESUME_MODEL=gpt-5.6-terra

FASTAPI_BASE_URL=http://hunter:8000
N8N_BASE_URL=http://n8n:5678
OLLAMA_BASE_URL=http://ollama:11434
HR_AGENT_OLLAMA_MODEL=gemma3:4b
HR_AGENT_OLLAMA_TIMEOUT_SECONDS=600
HR_AGENT_PROCESS_TIMEOUT_SECONDS=240
DICE_BROWSER_EXECUTABLE=/usr/bin/chromium

# Source-backed Hunter controls.
HUNTER_ENABLE_TELEGRAM=false
HUNTER_ENABLE_DISCOVERY_SCHEDULER=false
HUNTER_ENABLE_COORDINATOR=false

# Explicit shadow assertions consumed by Stage 8B/9 validators and operators.
TELEGRAM_ENABLED=false
DISCOVERY_ENABLED=false
SCHEDULER_ENABLED=false
COORDINATOR_ENABLED=false
PRODUCTION_CALLBACKS_ENABLED=false
CLOUD_SHADOW_MODE=true
PRODUCTION_STATE_IMPORTED=false
